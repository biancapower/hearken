{
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(config/master.key)",
      "Read(config/credentials/*.key)",
      "Read(.kamal/secrets*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/script/claude-guard.sh"
          }
        ]
      }
    ]
  }
}
